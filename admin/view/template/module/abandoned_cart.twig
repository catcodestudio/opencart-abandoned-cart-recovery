{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ carts }}" class="btn btn-outline-info"><i class="fa-solid fa-cart-shopping"></i> {{ heading_carts }}</a>
        <button type="submit" form="form-abandoned-cart" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="alert-abandoned-cart"></div>

    {% if crypto_broken %}
      <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_crypto_broken }}</div>
    {% endif %}

    {% if not is_pro and not notice_dismissed %}
      <div class="alert alert-info alert-dismissible d-flex align-items-center" id="cc-ac-notice">
        <i class="fa-solid fa-circle-info me-2"></i>
        <div class="flex-grow-1">{{ text_notice }}</div>
        <button type="button" class="btn btn-primary btn-sm ms-3" data-bs-toggle="modal" data-bs-target="#cc-ac-pro-modal">{{ text_try_pro }}</button>
        <button type="button" class="btn-close ms-2" id="cc-ac-notice-close"></button>
      </div>
    {% endif %}

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-abandoned-cart" action="{{ save }}" method="post">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ tab_general }}</a></li>
            <li class="nav-item"><a href="#tab-emails" data-bs-toggle="tab" class="nav-link">{{ tab_emails }}</a></li>
            <li class="nav-item"><a href="#tab-coupon" data-bs-toggle="tab" class="nav-link">{{ tab_coupon }}{% if not is_pro %} <span class="badge bg-warning text-dark">{{ text_pro_badge }}</span>{% endif %}</a></li>
            <li class="nav-item"><a href="#tab-telegram" data-bs-toggle="tab" class="nav-link">{{ tab_telegram }}{% if not is_pro %} <span class="badge bg-warning text-dark">{{ text_pro_badge }}</span>{% endif %}</a></li>
            <li class="nav-item"><a href="#tab-license" data-bs-toggle="tab" class="nav-link">{{ tab_license }}</a></li>
          </ul>

          <div class="tab-content">

            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="status" value="0"/>
                    <input type="checkbox" name="status" value="1" class="form-check-input"{% if status == '1' %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_abandon_after }}</label>
                <div class="col-sm-9">
                  <input type="number" min="1" step="1" name="abandon_after" value="{{ abandon_after }}" class="form-control"/>
                  <div class="form-text">{{ help_abandon_after }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_token_lifetime }}</label>
                <div class="col-sm-9">
                  <input type="number" min="1" step="1" name="token_lifetime" value="{{ token_lifetime }}" class="form-control"/>
                  <div class="form-text">{{ help_token_lifetime }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_email_cooldown }}</label>
                <div class="col-sm-9">
                  <input type="number" min="0" step="1" name="email_cooldown" value="{{ email_cooldown }}" class="form-control"/>
                  <div class="form-text">{{ help_email_cooldown }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_retention_days }}</label>
                <div class="col-sm-9">
                  <input type="number" min="0" step="1" name="retention_days" value="{{ retention_days }}" class="form-control"/>
                  <div class="form-text">{{ help_retention_days }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_cron }}</label>
                <div class="col-sm-9">
                  <input type="text" value="{{ cron_url }}" readonly class="form-control"/>
                  <div class="form-text">{{ help_cron }}</div>
                </div>
              </div>
            </div>

            <div id="tab-emails" class="tab-pane">
              {% for n in 1..3 %}
                {% set locked = n > 1 and not is_pro %}
                <fieldset{% if locked %} class="opacity-50"{% endif %}>
                  <legend class="fs-6">
                    {{ attribute(_context, 'legend_email_' ~ n) }}
                    {% if n > 1 %}<span class="badge bg-warning text-dark">{{ text_pro_badge }}</span>{% endif %}
                  </legend>
                  {% if locked %}<div class="small text-muted mb-3">{{ help_pro_reminders }}</div>{% endif %}

                  {% if n > 1 %}
                    <div class="row mb-3">
                      <label class="col-sm-3 col-form-label">{{ entry_enabled }}</label>
                      <div class="col-sm-9">
                        <div class="form-check form-switch form-switch-lg">
                          <input type="hidden" name="email_{{ n }}_enabled" value="0"/>
                          <input type="checkbox" name="email_{{ n }}_enabled" value="1" class="form-check-input"{% if attribute(_context, 'email_' ~ n ~ '_enabled') == '1' %} checked{% endif %}{% if locked %} disabled{% endif %}/>
                        </div>
                      </div>
                    </div>
                  {% endif %}

                  <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">{% if n == 1 %}{{ entry_delay_first }}{% else %}{{ entry_delay_next }}{% endif %}</label>
                    <div class="col-sm-9">
                      <input type="number" min="1" step="1" name="email_{{ n }}_delay" value="{{ attribute(_context, 'email_' ~ n ~ '_delay') }}" class="form-control"{% if locked %} disabled{% endif %}/>
                      <div class="form-text">{{ help_delay }}</div>
                    </div>
                  </div>

                  <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">{{ entry_subject }}</label>
                    <div class="col-sm-9">
                      <input type="text" name="email_{{ n }}_subject" value="{{ attribute(_context, 'email_' ~ n ~ '_subject') }}" class="form-control"{% if locked %} disabled{% endif %}/>
                    </div>
                  </div>

                  <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">{{ entry_body }}</label>
                    <div class="col-sm-9">
                      <textarea name="email_{{ n }}_body" rows="10" class="form-control font-monospace"{% if locked %} disabled{% endif %}>{{ attribute(_context, 'email_' ~ n ~ '_body') }}</textarea>
                      <div class="form-text">
                        {{ help_placeholders }}
                        <code>{customer_name}</code> <code>{cart_items}</code> <code>{cart_total}</code>
                        <code>{recovery_link}</code> <code>{store_name}</code> <code>{store_url}</code>
                        <code>{coupon}</code> <code>{coupon_code}</code>
                      </div>
                    </div>
                  </div>
                </fieldset>
                <hr/>
              {% endfor %}
            </div>

            <div id="tab-coupon" class="tab-pane">
              <div class="alert alert-light">{{ help_coupon_intro }}{% if not is_pro %} <strong>{{ text_pro_only }}</strong><div class="small text-muted mt-1">{{ help_pro_coupon }}</div>{% endif %}</div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_coupon_enabled }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="coupon_enabled" value="0"/>
                    <input type="checkbox" name="coupon_enabled" value="1" class="form-check-input"{% if coupon_enabled == '1' %} checked{% endif %}{% if not is_pro %} disabled{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_coupon_type }}</label>
                <div class="col-sm-9">
                  <select name="coupon_type" class="form-select"{% if not is_pro %} disabled{% endif %}>
                    <option value="P"{% if coupon_type == 'P' %} selected{% endif %}>{{ text_coupon_percent }}</option>
                    <option value="F"{% if coupon_type == 'F' %} selected{% endif %}>{{ text_coupon_fixed }}</option>
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_coupon_amount }}</label>
                <div class="col-sm-9"><input type="text" name="coupon_amount" value="{{ coupon_amount }}" class="form-control"{% if not is_pro %} disabled{% endif %}/></div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_coupon_from }}</label>
                <div class="col-sm-9">
                  <input type="number" min="1" max="3" step="1" name="coupon_from_email" value="{{ coupon_from_email }}" class="form-control"{% if not is_pro %} disabled{% endif %}/>
                  <div class="form-text">{{ help_coupon_from }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_coupon_expiry }}</label>
                <div class="col-sm-9"><input type="number" min="1" step="1" name="coupon_expiry_days" value="{{ coupon_expiry_days }}" class="form-control"{% if not is_pro %} disabled{% endif %}/></div>
              </div>
            </div>

            <div id="tab-telegram" class="tab-pane">
              <div class="alert alert-light">{{ help_telegram_intro }}{% if not is_pro %} <strong>{{ text_pro_only }}</strong><div class="small text-muted mt-1">{{ help_pro_telegram }}</div>{% endif %}</div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_telegram_enabled }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="telegram_enabled" value="0"/>
                    <input type="checkbox" name="telegram_enabled" value="1" class="form-check-input"{% if telegram_enabled == '1' %} checked{% endif %}{% if not is_pro %} disabled{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_telegram_token }}</label>
                <div class="col-sm-9">
                  <input type="password" name="telegram_bot_token" value="" autocomplete="new-password" class="form-control"{% if not is_pro %} disabled{% endif %}/>
                  <div class="form-text">
                    {% if telegram_bot_token_set %}<span class="text-success">{{ text_secret_stored }}</span> {% endif %}{{ help_telegram_token }}
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_telegram_bot }}</label>
                <div class="col-sm-9">
                  <button type="button" id="button-connect-bot" class="btn btn-primary"{% if not is_pro %} disabled{% endif %}>{{ button_connect_bot }}</button>
                  <button type="button" id="button-disconnect-bot" class="btn btn-outline-danger"{% if not is_pro %} disabled{% endif %}>{{ button_disconnect_bot }}</button>
                  <div class="form-text">
                    <span id="telegram-webhook-state" class="{% if telegram_webhook_set %}text-success{% else %}text-muted{% endif %}">
                      {% if not telegram_webhook_set %}
                        {{ text_webhook_off }}
                      {% elseif telegram_chat_id %}
                        {{ text_webhook_ready }}
                      {% else %}
                        {{ text_webhook_waiting }}
                      {% endif %}
                    </span>
                    <br/>{{ help_telegram_webhook }}
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_telegram_chat }}</label>
                <div class="col-sm-9">
                  <input type="text" name="telegram_chat_id" value="{{ telegram_chat_id }}" class="form-control"{% if not is_pro %} disabled{% endif %}/>
                  <div class="form-text">{{ help_telegram_chat }}</div>
                </div>
              </div>
            </div>

            <div id="tab-license" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_license }}</label>
                <div class="col-sm-9">
                  <div class="d-flex align-items-center flex-wrap gap-2" id="cc-ac-license-state">
                    {% if is_pro %}
                      {% if trial_active %}
                        <span class="badge bg-success">{{ text_trial_days_left|format(trial_days_left) }}</span>
                      {% else %}
                        <span class="badge bg-success">{{ text_pro_active }}</span>
                      {% endif %}
                      {% if license_expires %}
                        <span class="text-muted small">{{ text_license_until|format(license_expires) }}</span>
                      {% endif %}
                      <button type="button" class="btn btn-outline-secondary btn-sm" id="cc-ac-deactivate">{{ text_deactivate }}</button>
                    {% else %}
                      <span class="badge bg-secondary">{{ text_free_version }}</span>
                      <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#cc-ac-pro-modal">{{ text_try_pro }}</button>
                    {% endif %}
                  </div>
                  <div class="form-text">{{ help_license_pro }}</div>
                </div>
              </div>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="cc-ac-pro-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ text_modal_title }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-pills nav-fill mb-3">
          <li class="nav-item"><a href="#cc-ac-pane-trial" data-bs-toggle="tab" class="nav-link{% if trial_available %} active{% endif %}">{{ text_tab_trial }}</a></li>
          <li class="nav-item"><a href="#cc-ac-pane-key" data-bs-toggle="tab" class="nav-link{% if not trial_available %} active{% endif %}">{{ text_tab_key }}</a></li>
        </ul>
        <div class="tab-content">
          <div id="cc-ac-pane-trial" class="tab-pane{% if trial_available %} active{% endif %}">
            <p class="text-muted small">{{ text_trial_lede }}</p>
            <label class="form-label">{{ text_email }}</label>
            <input type="email" id="cc-ac-trial-email" class="form-control mb-3" placeholder="you@example.com"/>
            <button type="button" class="btn btn-primary w-100" id="cc-ac-trial-go">{{ text_get_key }}</button>
          </div>
          <div id="cc-ac-pane-key" class="tab-pane{% if not trial_available %} active{% endif %}">
            <p class="text-muted small">{{ text_key_lede }}</p>
            <label class="form-label">{{ entry_license }}</label>
            <input type="text" id="cc-ac-key" class="form-control mb-3" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off"/>
            <button type="button" class="btn btn-primary w-100" id="cc-ac-key-go">{{ text_activate }}</button>
          </div>
        </div>
        <div id="cc-ac-modal-result" class="mt-3"></div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
// Twig html-escapes controller URLs (& -> &amp;), which breaks fetch() targets:
// the user_token is lost and the login page comes back as HTML instead of JSON.
function ccAcUrl(s) { return s.replace(/&amp;/g, '&'); }

document.getElementById('form-abandoned-cart').addEventListener('submit', function (e) {
  e.preventDefault();
  var box = document.getElementById('alert-abandoned-cart');
  box.innerHTML = '';
  fetch(ccAcUrl('{{ save }}'), { method: 'POST', body: new FormData(this) })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (json.error) {
        box.innerHTML = '<div class="alert alert-danger">' + json.error + '</div>';
      } else if (json.success) {
        box.innerHTML = '<div class="alert alert-success">' + json.success + '</div>';
        document.querySelectorAll('input[name="telegram_bot_token"], input[name="license_key"]').forEach(function (el) { el.value = ''; });
      }
      window.scrollTo(0, 0);
    })
    .catch(function () { box.innerHTML = '<div class="alert alert-danger">Request failed</div>'; });
});

// Connect / disconnect the Telegram bot. The token field is write-only, so a
// value typed but not yet saved is posted along and the controller stores it.
function ccAcBot(url, withToken) {
  var box = document.getElementById('alert-abandoned-cart');
  var body = new FormData();
  if (withToken) {
    var token = document.querySelector('input[name="telegram_bot_token"]');
    body.append('telegram_bot_token', token ? token.value : '');
  }
  box.innerHTML = '';
  fetch(ccAcUrl(url), { method: 'POST', body: body, credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      var state = document.getElementById('telegram-webhook-state');
      if (json.error) {
        box.innerHTML = '<div class="alert alert-danger">' + json.error + '</div>';
      } else if (json.success) {
        box.innerHTML = '<div class="alert alert-success">' + json.success + '</div>';
        if (state) {
          state.textContent = json.connected ? '{{ text_webhook_waiting|escape('js') }}' : '{{ text_webhook_off|escape('js') }}';
          state.className = json.connected ? 'text-success' : 'text-muted';
        }
      }
      window.scrollTo(0, 0);
    })
    .catch(function () { box.innerHTML = '<div class="alert alert-danger">Request failed</div>'; });
}

document.getElementById('button-connect-bot').addEventListener('click', function () {
  ccAcBot('{{ connect_bot|raw }}', true);
});
document.getElementById('button-disconnect-bot').addEventListener('click', function () {
  ccAcBot('{{ disconnect_bot|raw }}', false);
});

// --------------------------------------------------------------- licensing
function ccAcPost(url, body, onOk) {
  var box = document.getElementById('cc-ac-modal-result');
  fetch(ccAcUrl(url), { method: 'POST', body: body, credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (json.error) {
        if (box) { box.innerHTML = '<div class="alert alert-danger mb-0">' + json.error + '</div>'; }
        return;
      }
      onOk(json, box);
    })
    .catch(function () {
      if (box) { box.innerHTML = '<div class="alert alert-danger mb-0">Request failed</div>'; }
    });
}

var ccAcTrialGo = document.getElementById('cc-ac-trial-go');
if (ccAcTrialGo) {
  ccAcTrialGo.addEventListener('click', function () {
    var email = document.getElementById('cc-ac-trial-email');
    var body  = new FormData();
    body.append('email', email ? email.value : '');

    ccAcPost('{{ license_trial|raw }}', body, function (json, box) {
      // The key is shown here as well as mailed: a shop owner who closes the
      // letter by accident should not have to ask support for it.
      var html = '<div class="alert alert-success mb-2">' + json.success + '</div>';
      if (json.key) {
        html += '<div class="input-group"><span class="input-group-text">{{ text_your_key|escape('js') }}</span>'
              + '<input type="text" class="form-control" id="cc-ac-issued-key" readonly value="' + json.key + '"/>'
              + '<button type="button" class="btn btn-outline-secondary" id="cc-ac-copy">{{ text_copy|escape('js') }}</button></div>';
      }
      if (json.expires_at) {
        html += '<div class="form-text">' + json.expires_at + '</div>';
      }
      box.innerHTML = html;

      var copy = document.getElementById('cc-ac-copy');
      if (copy) {
        copy.addEventListener('click', function () {
          var field = document.getElementById('cc-ac-issued-key');
          field.select();
          document.execCommand('copy');
          copy.textContent = '{{ text_copied|escape('js') }}';
        });
      }

      setTimeout(function () { location.reload(); }, 2500);
    });
  });
}

var ccAcKeyGo = document.getElementById('cc-ac-key-go');
if (ccAcKeyGo) {
  ccAcKeyGo.addEventListener('click', function () {
    var key  = document.getElementById('cc-ac-key');
    var body = new FormData();
    body.append('license_key', key ? key.value : '');

    ccAcPost('{{ license_activate|raw }}', body, function (json, box) {
      box.innerHTML = '<div class="alert alert-success mb-0">' + json.success + '</div>';
      setTimeout(function () { location.reload(); }, 1500);
    });
  });
}

var ccAcDeactivate = document.getElementById('cc-ac-deactivate');
if (ccAcDeactivate) {
  ccAcDeactivate.addEventListener('click', function () {
    var box = document.getElementById('alert-abandoned-cart');
    fetch(ccAcUrl('{{ license_deactivate|raw }}'), { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (json) {
        box.innerHTML = '<div class="alert alert-' + (json.error ? 'danger' : 'success') + '">' + (json.error || json.success) + '</div>';
        if (!json.error) { setTimeout(function () { location.reload(); }, 1200); }
      });
  });
}

var ccAcNoticeClose = document.getElementById('cc-ac-notice-close');
if (ccAcNoticeClose) {
  ccAcNoticeClose.addEventListener('click', function () {
    // Dismissed once means dismissed for good — no nagging on every page load.
    fetch(ccAcUrl('{{ dismiss_notice|raw }}'), { method: 'POST', credentials: 'same-origin' });
    var notice = document.getElementById('cc-ac-notice');
    if (notice) { notice.remove(); }
  });
}
</script>
{{ footer }}
