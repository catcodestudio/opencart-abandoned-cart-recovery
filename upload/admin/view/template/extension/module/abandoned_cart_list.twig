{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if is_pro %}
          <a href="{{ export }}{% if filter_status %}&amp;filter_status={{ filter_status }}{% endif %}" class="btn btn-success"><i class="fa fa-download"></i> {{ button_export }}</a>
        {% endif %}
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_carts }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">

    <div class="row">
      <div class="col-sm-3">
        <div class="panel panel-default"><div class="panel-body text-center">
          <h2 style="margin:0">{{ stats.abandoned }}</h2>
          <span class="text-muted">{{ text_tile_abandoned }}</span>
        </div></div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default"><div class="panel-body text-center">
          <h2 style="margin:0">{{ stats.recovered }}</h2>
          <span class="text-muted">{{ text_tile_recovered }}</span>
        </div></div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default"><div class="panel-body text-center">
          <h2 style="margin:0">{{ stats.revenue }}</h2>
          <span class="text-muted">{{ text_tile_revenue }}</span>
        </div></div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default"><div class="panel-body text-center">
          <h2 style="margin:0">{{ stats.rate }}</h2>
          <span class="text-muted">{{ text_tile_rate }}</span>
        </div></div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form method="get" action="index.php" class="form-inline">
          <input type="hidden" name="route" value="extension/module/abandoned_cart/carts"/>
          <input type="hidden" name="user_token" value="{{ user_token }}"/>
          <div class="form-group">
            <label>{{ entry_status }}</label>
            <select name="filter_status" class="form-control">
              {% for option in status_filters %}
                <option value="{{ option.value }}"{{ option.value == filter_status ? ' selected' : '' }}>{{ option.text }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group">
            <label>{{ entry_email }}</label>
            <input type="text" name="filter_email" value="{{ filter_email }}" class="form-control"/>
          </div>
          <button type="submit" class="btn btn-default"><i class="fa fa-search"></i> {{ button_filter }}</button>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-body table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td class="text-left">{{ column_customer }}</td>
              <td class="text-left">{{ column_products }}</td>
              <td class="text-right">{{ column_total }}</td>
              <td class="text-left">{{ column_status }}</td>
              <td class="text-center">{{ column_reminders }}</td>
              <td class="text-left">{{ column_captured }}</td>
            </tr>
          </thead>
          <tbody>
          {% if carts %}
            {% for cart in carts %}
              <tr>
                <td class="text-left">
                  <strong>{{ cart.email }}</strong>
                  {% if cart.customer_name %}<br/><span class="text-muted">{{ cart.customer_name }}</span>{% endif %}
                  {% if cart.registered %}<br/><span class="text-muted">{{ text_registered }}</span>{% endif %}
                </td>
                <td class="text-left">
                  {% for line in cart.items %}{{ line }}<br/>{% else %}&mdash;{% endfor %}
                </td>
                <td class="text-right">
                  {{ cart.cart_total }}
                  {% if cart.order_link %}<br/><a href="{{ cart.order_link }}">#{{ cart.recovered_order_id }}</a>{% endif %}
                </td>
                <td class="text-left">
                  {% if cart.status == 'recovered' %}<span class="label label-success">{{ cart.status_text }}</span>
                  {% elseif cart.status == 'abandoned' %}<span class="label label-warning">{{ cart.status_text }}</span>
                  {% elseif cart.status == 'active' %}<span class="label label-info">{{ cart.status_text }}</span>
                  {% else %}<span class="label label-default">{{ cart.status_text }}</span>{% endif %}
                </td>
                <td class="text-center">
                  {{ cart.emails_sent }}
                  {% if cart.last_email_at %}<br/><span class="text-muted">{{ cart.last_email_at }}</span>{% endif %}
                  {% if cart.coupon_code %}<br/><code>{{ cart.coupon_code }}</code>{% endif %}
                </td>
                <td class="text-left">
                  {{ cart.created_at }}
                  {% if cart.abandoned_at %}<br/><span class="text-muted">{{ text_abandoned_at }} {{ cart.abandoned_at }}</span>{% endif %}
                </td>
              </tr>
            {% endfor %}
          {% else %}
            <tr><td colspan="6" class="text-center">{{ text_no_carts }}</td></tr>
          {% endif %}
          </tbody>
        </table>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
